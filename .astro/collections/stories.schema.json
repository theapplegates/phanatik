{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "sport": {
      "type": "string",
      "enum": [
        "Football",
        "Basketball",
        "Tennis",
        "Cycling",
        "Formula 1",
        "Athletics",
        "Opinion"
      ]
    },
    "writer": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "collection": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "collection"
          ]
        },
        {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            },
            "collection": {
              "type": "string"
            }
          },
          "required": [
            "slug",
            "collection"
          ]
        }
      ]
    },
    "image": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "alt"
      ]
    },
    "placement": {
      "default": "standard",
      "type": "string",
      "enum": [
        "lead",
        "featured",
        "standard"
      ]
    },
    "live": {
      "default": false,
      "type": "boolean"
    },
    "members": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "pubDate",
    "description",
    "sport",
    "writer",
    "image"
  ]
}