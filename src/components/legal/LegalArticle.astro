---
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
import { getCollection, type CollectionEntry } from "astro:content";
import { formatDate } from "@/lib/format";
interface Props {
  id: string;
  frontmatter: CollectionEntry<"legal">["data"];
}
const { id, frontmatter } = Astro.props;
const pages = await getCollection("legal");
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <aside class="flex flex-col gap-4 lg:col-span-4">
        <p class="text-sm text-muted-foreground">
          Updated on <time datetime={frontmatter.pubDate.toISOString()}>{formatDate(frontmatter.pubDate)}</time>
        </p>
        <ul class="flex flex-col gap-2">
          {
            pages.map((item) => (
              <li>
                <a
                  href={`/legal/${item.id}`}
                  aria-current={item.id === id ? "page" : undefined}
                  class="text-base text-muted-foreground duration-300 hover:text-foreground current:font-medium current:text-foreground"
                >
                  {item.data.page}
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
      <div
        class="max-w-2xl prose text-foreground prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-foreground prose-p:text-foreground prose-li:text-foreground prose-strong:text-foreground lg:col-span-8"
      >
        <slot />
      </div>
    </div>
  </Wrapper>
</section>
