---
// Assets
import CloudinaryImage from "@/components/CloudinaryImage.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
import { getPosts, postHref } from "@/lib/blog";
import { formatDate, formatShortDate } from "@/lib/format";
const posts = await getPosts();
const lead =
  posts.find((post) => post.data.featured && post.data.coverImage) ??
  posts.find((post) => post.data.coverImage) ??
  posts[0];
const latest = lead ? posts.filter((post) => post.id !== lead.id).slice(0, 7) : [];
---

<section>
  <Wrapper variant="standard" class="py-8">
    {
      lead ? (
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
          <a href={postHref(lead.id)} class="flex flex-col gap-6 group lg:col-span-8">
            {lead.data.coverImage && (
              <CloudinaryImage
                publicId={lead.data.coverImage}
                cloudName={lead.data.coverCloudName}
                alt={lead.data.coverAlt ?? ""}
                width={1600}
                height={1067}
                sizes="(max-width: 1024px) 100vw, 66vw"
                loading="eager"
                fetchpriority="high"
                pictureClass="block overflow-hidden rounded-xl"
                class="object-cover w-full aspect-3/2 duration-500 ease-out group-hover:scale-102"
              />
            )}
            <div class="flex flex-col gap-4">
              <Text tag="h1" variant="displayLG" class="font-semibold leading-tight tracking-tight text-foreground text-balance">
                {lead.data.title}
              </Text>
              <Text tag="p" variant="textLG" class="max-w-2xl text-muted-foreground text-pretty">
                {lead.data.description}
              </Text>
              <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted-foreground">
                <time datetime={lead.data.pubDate.toISOString()}>{formatDate(lead.data.pubDate)}</time>
                {lead.data.tags.length > 0 && <span>{lead.data.tags.join(", ")}</span>}
              </p>
            </div>
          </a>
          <aside class="lg:col-span-4 lg:pl-8 lg:border-l lg:border-muted">
            <h2 class="text-sm font-semibold text-foreground">Latest</h2>
            <ol class="flex flex-col mt-4 divide-y divide-muted">
              {latest.map((post) => (
                <li>
                  <a href={postHref(post.id)} class="flex flex-col gap-2 py-4 group">
                    <h3 class="text-base font-medium leading-snug text-foreground text-pretty duration-300 group-hover:text-muted-foreground">
                      {post.data.title}
                    </h3>
                    <p class="flex items-center gap-3 text-xs text-muted-foreground">
                      <time datetime={post.data.pubDate.toISOString()}>{formatShortDate(post.data.pubDate)}</time>
                    </p>
                  </a>
                </li>
              ))}
            </ol>
          </aside>
        </div>
      ) : (
        <div class="flex flex-col max-w-xl gap-4 py-12">
          <Text tag="h1" variant="displayLG" class="font-semibold leading-tight tracking-tight text-foreground">
            Nothing published yet
          </Text>
          <Text tag="p" variant="textLG" class="text-muted-foreground text-pretty">
            Write your first post in src/content/blog and it will appear here.
          </Text>
        </div>
      )
    }
  </Wrapper>
</section>
