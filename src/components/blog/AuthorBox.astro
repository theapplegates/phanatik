---
import { site } from "@/site.config";
---

<div class="flex flex-col gap-1 pt-8 mt-12 border-t border-muted">
  <span class="text-base font-semibold text-foreground">{site.author.name}</span>
  <span class="text-sm text-muted-foreground">{site.author.role}</span>
  <p class="mt-2 text-sm text-muted-foreground text-pretty">{site.author.bio}</p>
  {
    site.author.links.length > 0 && (
      <ul class="flex flex-wrap gap-x-4 gap-y-1 mt-2">
        {site.author.links.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-muted-foreground duration-300 hover:text-foreground">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>
