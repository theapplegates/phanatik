---
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Plus from "@/components/fundations/icons/Plus.astro";
interface Props {
  isLink?: boolean;
}
const { isLink = false } = Astro.props;
const variants = [
  { name: "Default", variant: "default" },
  { name: "Muted", variant: "muted" },
  { name: "None", variant: "none" },
];
const sizes = [
  { name: "XXS", size: "xxs", icon: "sm" },
  { name: "XS", size: "xs", icon: "sm" },
  { name: "SM", size: "sm", icon: "base" },
  { name: "Base", size: "base", icon: "base" },
  { name: "MD", size: "md", icon: "lg" },
  { name: "LG", size: "lg", icon: "xl" },
  { name: "XL", size: "xl", icon: "xl" },
];
const linkProps = isLink ? { isLink: true, href: "#_" } : {};
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div class="flex flex-col divide-y divide-muted">
      {
        variants.map((item) => (
          <div class="grid grid-cols-1 gap-6 py-8 lg:grid-cols-12">
            <h2 class="text-xl font-semibold tracking-tight text-foreground lg:col-span-3">{item.name}</h2>
            <div class="flex flex-col gap-6 lg:col-span-9">
              <div class="flex flex-wrap items-end gap-4">
                {sizes.map((size) => (
                  <Button {...linkProps} size={size.size} variant={item.variant}>
                    {item.name} {size.name}
                  </Button>
                ))}
              </div>
              <div class="flex flex-wrap items-end gap-4">
                {sizes.map((size) => (
                  <Button {...linkProps} size={size.size} variant={item.variant} iconOnly aria-label={`${item.name} ${size.name}`}>
                    <Plus slot="icon" size={size.icon} />
                  </Button>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
