---
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import SectionHeader from "@/components/landing/SectionHeader.astro";
import StoryCard from "@/components/stories/StoryCard.astro";
// Content
import { getStories } from "@/lib/stories";
const stories = (await getStories()).filter((story) => story.data.members).slice(1, 5);
---

<section>
  <Wrapper variant="standard" class="py-12">
    <SectionHeader title="What members read" />
    <ul class="grid grid-cols-1 gap-8 mt-6 sm:grid-cols-2 lg:grid-cols-4">
      {stories.map((story) => <li><StoryCard story={story} /></li>)}
    </ul>
  </Wrapper>
</section>
