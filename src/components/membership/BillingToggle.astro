---
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
---

<div role="group" aria-label="Billing period" class="flex gap-1">
  <Button type="button" size="xs" variant="default" data-billing-option="monthly" aria-pressed="true">Monthly</Button>
  <Button type="button" size="xs" variant="none" class="text-muted-foreground hover:text-foreground" data-billing-option="yearly" aria-pressed="false">Yearly</Button>
</div>

<script>
  const options = [...document.querySelectorAll<HTMLButtonElement>("[data-billing-option]")];
  const panels = document.querySelectorAll<HTMLElement>("[data-billing-panel]");
  options.forEach((option) => {
    option.addEventListener("click", () => {
      if (option.getAttribute("aria-pressed") === "true") return;
      const active = options.find((item) => item.getAttribute("aria-pressed") === "true");
      if (active) {
        [active.className, option.className] = [option.className, active.className];
        active.setAttribute("aria-pressed", "false");
      }
      option.setAttribute("aria-pressed", "true");
      panels.forEach((panel) => (panel.hidden = panel.dataset.billingPanel !== option.dataset.billingOption));
    });
  });
</script>
