---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Check from "@/components/fundations/icons/Check.astro";
const plans = [
  {
    name: "Reader",
    description: "For following the scores and the news, every day.",
    price: "€0",
    period: "for ever",
    note: "Just an email address, no card needed",
    features: [
      "Every news story and match report",
      "Live scores and results",
      "The morning briefing, every weekday",
      "Three members stories a month",
    ],
    cta: { label: "Create an account", href: "/signup" },
  },
  {
    name: "Member",
    description: "For the long reads and the stories behind the results.",
    price: "€5",
    period: "a month",
    note: "Or €50 a year, two months free. Cancel any time",
    features: [
      "Everything for readers, without the limit",
      "Long reads, analysis and every members story",
      "All four newsletters, including the Sunday long read",
      "No adverts, on any page",
      "Questions to the desk in the monthly live chat",
    ],
    cta: { label: "Become a member", href: "/signup" },
  },
];
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        plans.map((plan) => (
          <div class="flex flex-col p-2 rounded-3xl shadow-button-muted text-foreground">
            <div class="flex flex-col gap-8 p-6 rounded-2xl bg-linear-to-b from-muted to-background">
              <div class="flex flex-col gap-2">
                <Text tag="h2" variant="textLG" class="font-semibold tracking-tight">
                  {plan.name}
                </Text>
                <Text tag="p" variant="textSM" class="text-muted-foreground">
                  {plan.description}
                </Text>
              </div>
              <div class="flex flex-col gap-2">
                <p class="flex items-baseline gap-2">
                  <span class="text-5xl font-semibold tracking-tight tabular-nums">{plan.price}</span>
                  <span class="text-base text-muted-foreground">{plan.period}</span>
                </p>
                <Text tag="p" variant="textSM" class="text-muted-foreground">
                  {plan.note}
                </Text>
              </div>
              <Button isLink href={plan.cta.href} size="base" variant="default" class="w-full">
                {plan.cta.label}
              </Button>
            </div>
            <ul class="flex flex-col gap-3 p-6">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3 text-base">
                  <Check size="sm" class="mt-1 shrink-0 text-muted-foreground" />
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
