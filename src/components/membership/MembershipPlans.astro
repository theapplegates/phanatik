---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Check from "@/components/fundations/icons/Check.astro";
const plans = [
  {
    name: "Reader",
    description: "For following the scores and the news, every day.",
    monthly: { price: "€0", period: "for ever", note: "Just an email address, no card needed" },
    yearly: { price: "€0", period: "for ever", note: "Just an email address, no card needed" },
    features: [
      "Every news story and match report",
      "Live scores and results",
      "The morning briefing, every weekday",
      "Three members stories a month",
    ],
    cta: { label: "Create an account", href: "/signup" },
  },
  {
    name: "Member",
    description: "For the long reads and the stories behind the results.",
    monthly: { price: "€5", period: "a month", note: "Billed every month. Cancel any time" },
    yearly: { price: "€50", period: "a year", note: "Two months free. Cancel any time" },
    features: [
      "Everything for readers, without the limit",
      "Long reads, analysis and every members story",
      "All four newsletters, including the Sunday long read",
      "No adverts, on any page",
      "Questions to the desk in the monthly live chat",
    ],
    cta: { label: "Become a member", href: "/signup" },
  },
];
const billing = ["monthly", "yearly"] as const;
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div data-billing="monthly" class="flex flex-col gap-12">
      <div role="group" aria-label="Billing period" class="flex self-start gap-1 p-1 rounded-lg bg-muted">
        {
          billing.map((period) => (
            <button
              type="button"
              data-billing-option={period}
              aria-pressed={period === "monthly" ? "true" : "false"}
              class="h-8 px-4 text-sm font-medium capitalize duration-300 rounded-sm text-muted-foreground hover:text-foreground aria-pressed:bg-background aria-pressed:text-foreground"
            >
              {period}
            </button>
          ))
        }
      </div>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
        {
          plans.map((plan) => (
            <div class="flex flex-col gap-8 text-foreground">
              <div class="flex flex-col gap-2">
                <Text tag="h2" variant="textLG" class="font-semibold tracking-tight">
                  {plan.name}
                </Text>
                <Text tag="p" variant="textSM" class="text-muted-foreground">
                  {plan.description}
                </Text>
              </div>
              {billing.map((period) => (
                <div data-billing-panel={period} hidden={period !== "monthly"} class="flex flex-col gap-2">
                  <p class="flex items-baseline gap-2">
                    <span class="text-5xl font-semibold tracking-tight tabular-nums">{plan[period].price}</span>
                    <span class="text-base text-muted-foreground">{plan[period].period}</span>
                  </p>
                  <Text tag="p" variant="textSM" class="text-muted-foreground">
                    {plan[period].note}
                  </Text>
                </div>
              ))}
              <ul class="flex flex-col gap-3">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-3 text-base">
                    <Check size="sm" class="mt-1 shrink-0 text-muted-foreground" />
                    {feature}
                  </li>
                ))}
              </ul>
              <Button isLink href={plan.cta.href} size="base" variant="default" class="w-fit mt-auto">
                {plan.cta.label}
              </Button>
            </div>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-billing]").forEach((root) => {
    const options = root.querySelectorAll<HTMLButtonElement>("[data-billing-option]");
    const panels = root.querySelectorAll<HTMLElement>("[data-billing-panel]");
    options.forEach((option) => {
      option.addEventListener("click", () => {
        const period = option.dataset.billingOption;
        options.forEach((item) => item.setAttribute("aria-pressed", String(item === option)));
        panels.forEach((panel) => (panel.hidden = panel.dataset.billingPanel !== period));
      });
    });
  });
</script>
