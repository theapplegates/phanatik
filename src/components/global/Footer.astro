---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Data
import { site } from "@/site.config";
const links = site.nav.filter((link) => link.href !== "/rss.xml");
---

<footer class="bg-foreground text-background">
  <Wrapper variant="standard" class="py-16">
    <div class="flex flex-col max-w-sm gap-6">
      <a href="/" aria-label={`${site.name} home`} class="text-background"><Logo /></a>
      <Text tag="p" variant="textSM" class="text-background/60 text-pretty">
        {site.description}
      </Text>
      <ul class="flex flex-col gap-2">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-background/60 duration-300 hover:text-background">
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/rss.xml" class="text-sm text-background/60 duration-300 hover:text-background">RSS</a>
        </li>
      </ul>
    </div>
    <div class="pt-8 mt-16 border-t border-background/15">
      <Text tag="p" variant="textXS" class="text-background/60">
        © {new Date().getFullYear()} {site.name}. All rights reserved.
      </Text>
    </div>
  </Wrapper>
</footer>
