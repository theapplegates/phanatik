---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Data
import { sports, sportSlug } from "@/lib/sports";
const columns = [
  {
    title: "Sports",
    links: sports.map((sport) => ({ label: sport, href: `/sports/${sportSlug(sport)}` })),
  },
  {
    title: "The Absurdist",
    links: [
      { label: "About", href: "/about" },
      { label: "Writers", href: "/writers" },
      { label: "Membership", href: "/membership" },
      { label: "Newsletters", href: "/newsletters" },
      { label: "Contact", href: "/contact" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Privacy", href: "/legal/privacy" },
      { label: "Terms", href: "/legal/terms" },
      { label: "Cookies", href: "/legal/cookies" },
      { label: "License", href: "https://lexingtonthemes.com/legal/license" },
      { label: "Documentation", href: "https://lexingtonthemes.com/documentation" },
    ],
  },
];
---

<footer class="border-t border-muted">
  <Wrapper variant="standard" class="py-16">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="flex flex-col gap-6 lg:col-span-5">
        <a href="/" aria-label="The Absurdist home" class="text-foreground"><Logo /></a>
        <Text tag="p" variant="textSM" class="max-w-sm text-muted-foreground text-pretty">
          World sports, every day. Football, basketball, tennis, cycling,
          Formula 1 and athletics, reported by people who were there.
        </Text>
        <form class="flex flex-col gap-2 max-w-sm" onsubmit="return false">
          <label for="footer-email" class="text-sm font-medium text-foreground">The morning briefing</label>
          <div class="flex gap-2">
            <input
              id="footer-email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@absurdist.test"
              class="w-full h-9 px-3 text-sm bg-background border rounded-lg border-muted text-foreground placeholder:text-muted-foreground focus:border-foreground/30 focus:ring-3 focus:ring-foreground/10"
            />
            <Button type="submit" size="sm" variant="default">Subscribe</Button>
          </div>
        </form>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-7">
        {
          columns.map((column) => (
            <div>
              <h2 class="text-sm font-semibold text-foreground">{column.title}</h2>
              <ul class="flex flex-col gap-2 mt-4">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-sm text-muted-foreground duration-300 hover:text-foreground">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <div class="pt-8 mt-16 border-t border-muted">
      <Text tag="p" variant="textXS" class="text-muted-foreground">
        © {new Date().getFullYear()} The Absurdist. All rights reserved.
      </Text>
    </div>
  </Wrapper>
</footer>
