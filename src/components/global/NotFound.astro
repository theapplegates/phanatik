---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div class="flex flex-col max-w-xl gap-6">
      <Text tag="h1" variant="displayXL" class="font-semibold leading-tight tracking-tight text-foreground text-balance">
        This page does not exist
      </Text>
      <Text tag="p" variant="textLG" class="text-muted-foreground text-pretty">
        The link is broken or the page has moved. The blog home has the latest posts.
      </Text>
      <div class="flex">
        <Button isLink href="/" size="sm" variant="default">Back to the blog</Button>
      </div>
    </div>
  </Wrapper>
</section>
