---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Data
import { site } from "@/site.config";
const path = Astro.url.pathname;
const links = site.nav;
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 bg-background border-b border-muted">
  <Wrapper variant="standard">
    <nav class="flex items-center justify-between gap-6 h-16">
      <a href="/" aria-label={`${site.name} home`} class="text-foreground"><Logo /></a>
      <ul class="flex items-center gap-6">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
                class="text-sm font-medium text-muted-foreground duration-300 hover:text-foreground current:text-foreground"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Wrapper>
</header>
