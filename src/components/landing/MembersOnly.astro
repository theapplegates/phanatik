---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import StoryCard from "@/components/stories/StoryCard.astro";
// Content
import { getStories } from "@/lib/stories";
const members = (await getStories()).filter((story) => story.data.members).slice(0, 4);
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div class="p-6 rounded-2xl bg-muted lg:p-8">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="flex flex-col gap-2">
          <Text tag="h2" variant="displayXS" class="font-semibold tracking-tight text-foreground">
            For members
          </Text>
          <Text tag="p" variant="textSM" class="max-w-md text-muted-foreground text-pretty">
            Long reads, analysis and the stories behind the results, from €5 a month.
          </Text>
        </div>
        <div class="flex">
          <Button isLink href="/membership" size="sm" variant="default">Become a member</Button>
        </div>
      </div>
      <ul class="grid grid-cols-1 gap-8 mt-8 sm:grid-cols-2 lg:grid-cols-4">
        {members.map((story) => <li><StoryCard story={story} /></li>)}
      </ul>
    </div>
  </Wrapper>
</section>
