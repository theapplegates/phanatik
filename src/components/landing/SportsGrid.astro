---
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import SectionHeader from "@/components/landing/SectionHeader.astro";
import StoryCard from "@/components/stories/StoryCard.astro";
// Content
import { getStories } from "@/lib/stories";
import { sportSlug, type Sport } from "@/lib/sports";
import { scores } from "@/lib/scores";
const grid: Sport[] = ["Basketball", "Tennis", "Cycling", "Formula 1", "Athletics"];
const stories = await getStories();
const blocks = grid.map((sport) => {
  const [main, ...rest] = stories.filter((story) => story.data.sport === sport);
  return { sport, main, more: rest.slice(0, 2) };
});
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        blocks.map((block) => (
          <div>
            <SectionHeader title={block.sport} href={`/sports/${sportSlug(block.sport)}`} label="More" />
            <div class="mt-6">{block.main && <StoryCard story={block.main} />}</div>
            <ul class="flex flex-col mt-4 divide-y divide-muted">
              {block.more.map((story) => <li class="py-4"><StoryCard story={story} size="row" /></li>)}
            </ul>
          </div>
        ))
      }
      <div>
        <SectionHeader title="Scores" />
        <ul class="flex flex-col mt-2 divide-y divide-muted">
          {
            scores.map((match) => (
              <li class="flex items-center justify-between gap-4 py-3 text-sm">
                <span class="flex flex-col">
                  <span class="text-foreground">{match.home}</span>
                  <span class="text-foreground">{match.away}</span>
                </span>
                <span class="flex flex-col items-end">
                  <span class="font-semibold tabular-nums text-foreground">{match.score}</span>
                  <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    {match.live && <span class="rounded-full size-1.5 bg-foreground" />}
                    {match.sport}, {match.status}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Wrapper>
</section>
