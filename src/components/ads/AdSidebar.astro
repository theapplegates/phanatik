---
// Assets
import { Image } from "astro:assets";
import kobbe from "@/images/ads/kobbe.webp";
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
---

<aside class="flex flex-col gap-3">
  <div class="flex flex-col gap-2 p-2 rounded-2xl bg-foreground text-background">
    <a href="https://kobbe.io" target="_blank" rel="noopener sponsored">
      <Image src={kobbe} alt="Kobbe analytics dashboard" width={1200} height={630} class="w-full h-auto rounded-lg" />
    </a>
    <div class="flex flex-col gap-6 p-4">
      <div class="flex flex-col gap-3">
        <p class="text-2xl font-medium leading-tight tracking-tight text-balance">Web analytics that respect your visitors</p>
        <p class="text-base text-background/70 text-pretty">
          Traffic, pages, referrers, devices, custom events and revenue, without tracking anyone.
        </p>
      </div>
      <div class="flex">
        <Button isLink href="https://kobbe.io" target="_blank" rel="noopener sponsored" size="sm" variant="muted">Try Kobbe</Button>
      </div>
    </div>
  </div>
  <p class="text-xs text-muted-foreground">
    Advertisement. <a href="/advertise" class="text-foreground duration-300 hover:text-muted-foreground">Advertise with us</a>
  </p>
</aside>
