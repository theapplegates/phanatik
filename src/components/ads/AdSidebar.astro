---
// Assets
import { Image } from "astro:assets";
import sprint from "@/images/stories/athletics-sprint.webp";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
---

<aside class="flex flex-col gap-3">
  <div class="flex flex-col overflow-hidden rounded-xl bg-foreground text-background">
    <Image src={sprint} alt="A sprinter crossing the line with her arms raised" width={800} height={600} class="object-cover w-full aspect-4/3" />
    <div class="flex flex-col gap-4 p-6">
      <Text tag="p" variant="displayXS" class="font-semibold leading-tight tracking-tight text-balance">
        The stories behind the results, without a single advert
      </Text>
      <Text tag="p" variant="textSM" class="text-background/60 text-pretty">
        Long reads, analysis and every newsletter. €5 a month, cancel any time.
      </Text>
      <div class="flex">
        <Button isLink href="/membership" size="sm" variant="muted">Become a member</Button>
      </div>
    </div>
  </div>
  <p class="text-xs text-muted-foreground">
    Advertisement. <a href="/advertise" class="text-foreground duration-300 hover:text-muted-foreground">Advertise with us</a>
  </p>
</aside>
