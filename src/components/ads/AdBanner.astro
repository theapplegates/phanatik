---
// Assets
import { Image } from "astro:assets";
import kobbe from "@/images/ads/kobbe.webp";
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div class="flex flex-col gap-3">
      <div class="grid grid-cols-1 gap-2 p-2 rounded-2xl bg-foreground text-background md:grid-cols-12">
        <a href="https://kobbe.io" target="_blank" rel="noopener sponsored" class="hidden self-center md:col-span-7 md:block">
          <Image src={kobbe} alt="Kobbe analytics dashboard" width={1200} height={630} class="w-full h-auto rounded-lg" />
        </a>
        <div class="flex flex-col justify-between gap-8 p-6 md:col-span-5">
          <div class="flex flex-col gap-4">
            <p class="text-4xl font-medium leading-tight tracking-tight text-balance">Web analytics that respect your visitors</p>
            <p class="text-lg text-background/70 text-pretty">
              Privacy-friendly analytics for traffic, pages, referrers, locations, devices, custom events and revenue.
            </p>
          </div>
          <div class="flex">
            <Button isLink href="https://kobbe.io" target="_blank" rel="noopener sponsored" size="sm" variant="muted">Try Kobbe</Button>
          </div>
        </div>
      </div>
      <p class="text-xs text-muted-foreground">
        Advertisement. <a href="/advertise" class="text-foreground duration-300 hover:text-muted-foreground">Advertise with us</a>
      </p>
    </div>
  </Wrapper>
</section>
