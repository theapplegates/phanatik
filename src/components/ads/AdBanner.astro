---
// Assets
import { Image } from "astro:assets";
import serve from "@/images/stories/tennis-serve.webp";
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div class="flex flex-col gap-3">
      <div class="flex flex-col gap-2 p-2 rounded-2xl bg-foreground text-background sm:flex-row sm:items-center">
        <Image
          src={serve}
          alt="A tennis player tossing the ball to serve under the lights"
          width={480}
          height={320}
          class="object-cover w-full rounded-lg aspect-3/2 sm:w-48 shrink-0"
        />
        <div class="flex flex-col gap-1 px-4 py-2 grow">
          <p class="text-xl font-semibold leading-tight tracking-tight text-balance">Last night's results before your coffee</p>
          <p class="text-sm text-background/60 text-pretty">The morning briefing, weekdays at 7:00. Free, and one click to leave.</p>
        </div>
        <div class="flex p-4 shrink-0">
          <Button isLink href="/newsletters" size="sm" variant="muted">Get the briefing</Button>
        </div>
      </div>
      <p class="text-xs text-muted-foreground">
        Advertisement. <a href="/advertise" class="text-foreground duration-300 hover:text-muted-foreground">Advertise with us</a>
      </p>
    </div>
  </Wrapper>
</section>
