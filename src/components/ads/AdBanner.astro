---
// Assets
import { Image } from "astro:assets";
import serve from "@/images/stories/tennis-serve.webp";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div class="flex flex-col gap-3">
      <div class="grid grid-cols-1 overflow-hidden rounded-xl bg-foreground text-background md:grid-cols-12">
        <div class="flex flex-col justify-center gap-4 p-6 md:col-span-7 lg:p-10">
          <Text tag="p" variant="displayMD" class="font-semibold leading-tight tracking-tight text-balance">
            Last night's results before your coffee
          </Text>
          <Text tag="p" variant="textBase" class="max-w-md text-background/60 text-pretty">
            The morning briefing lands at 7:00 on weekdays. Scores, fixtures and the one story worth reading.
          </Text>
          <div class="flex">
            <Button isLink href="/newsletters" size="sm" variant="muted">Get the briefing</Button>
          </div>
        </div>
        <Image src={serve} alt="A tennis player tossing the ball to serve under the lights" width={1000} height={667} class="object-cover w-full h-full aspect-3/2 md:col-span-5 md:aspect-auto" />
      </div>
      <p class="text-xs text-muted-foreground">
        Advertisement. <a href="/advertise" class="text-foreground duration-300 hover:text-muted-foreground">Advertise with us</a>
      </p>
    </div>
  </Wrapper>
</section>
