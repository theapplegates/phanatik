---
// Assets
import { Image } from "astro:assets";
import serve from "@/images/stories/tennis-serve.webp";
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div class="flex flex-col gap-3">
      <div class="grid grid-cols-1 gap-2 p-2 rounded-2xl bg-foreground text-background md:grid-cols-12">
        <Image
          src={serve}
          alt="A tennis player tossing the ball to serve under the lights"
          width={1000}
          height={667}
          class="object-cover w-full h-full rounded-lg aspect-3/2 md:col-span-5"
        />
        <div class="flex flex-col justify-between gap-8 p-6 md:col-span-7">
          <div class="flex flex-col gap-4">
            <p class="max-w-lg text-3xl font-medium leading-tight tracking-tight text-balance">Last night's results before your coffee</p>
            <p class="max-w-md text-base text-background/70 text-pretty">The morning briefing, weekdays at 7:00. Free, and one click to leave.</p>
          </div>
          <div class="flex">
            <Button isLink href="/newsletters" size="sm" variant="muted">Get the briefing</Button>
          </div>
        </div>
      </div>
      <p class="text-xs text-muted-foreground">
        Advertisement. <a href="/advertise" class="text-foreground duration-300 hover:text-muted-foreground">Advertise with us</a>
      </p>
    </div>
  </Wrapper>
</section>
