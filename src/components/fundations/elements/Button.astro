---
const {
  variant,
  size,
  onlyIconSize,
  iconOnly = false,
  gap,
  isLink = false,
  class: className,
  ...rest
} = Astro.props;
const defaultClass = [
  "text-background",
  "bg-linear-to-b from-foreground/80 to-foreground",
  "shadow-button-default",
  "hover:brightness-125",
];
const mutedClass = [
  "text-foreground",
  "bg-linear-to-b from-background to-muted",
  "shadow-button-muted",
  "hover:brightness-97",
];

// Size
const sizes = {
  xxs: ["h-7", "px-3", "text-xs", "rounded-md"],
  xs: ["h-8", "px-3.5", "text-xs", "rounded-md"],
  sm: ["h-9", "px-4", "text-sm", "rounded-lg"],
  base: ["h-10", "px-5", "text-sm", "rounded-lg"],
  md: ["h-11", "px-5", "text-base", "rounded-lg"],
  lg: ["h-12", "px-6", "text-base", "rounded-lg"],
  xl: ["h-13", "px-7", "text-lg", "rounded-lg"],
};
// Icon size
const iconSizes = {
  xxs: ["size-7", "text-xs", "rounded-md"],
  xs: ["size-8", "text-xs", "rounded-md"],
  sm: ["size-9", "text-sm", "rounded-lg"],
  base: ["size-10", "text-base", "rounded-lg"],
  md: ["size-11", "text-md", "rounded-lg"],
  lg: ["size-12", "text-lg", "rounded-lg"],
  xl: ["size-13", "text-base", "rounded-lg"],
};
// Gaps
const gapMap = {
  xs: ["gap-2"],
  sm: ["gap-4"],
  base: ["gap-8"],
  md: ["gap-10"],
  lg: ["gap-12"],
};
const variantClass = {
  default: defaultClass,
  muted: mutedClass,
  none: [],
};
const sizeClass = iconOnly ? iconSizes[size] : sizes[size] || [];
const gapClass = !iconOnly && gap ? gapMap[gap] : [];
const additionalClasses = className ? className.split(" ") : [];
const baseClass = [
  "flex",
  "justify-center",
  "text-center",
  "font-medium",
  "items-center",
  "whitespace-nowrap",
  "duration-200",
  "ease-out",
  "transition",
  "active:scale-98",
  "focus-visible:outline-none",
  "focus-visible:ring-3",
  "focus-visible:ring-foreground/20",
];
---

{
  isLink ? (
    <a
      href={rest.href}
      class:list={[
        ...baseClass,
        ...(variantClass[variant] || []),
        ...sizeClass,
        ...gapClass,
        ...additionalClasses,
      ]}
      {...rest}
    >
      {iconOnly ? (
        <slot name="icon" />
      ) : (
        <>
          <slot name="left-icon" />
          <slot />
          <slot name="right-icon" />
        </>
      )}
    </a>
  ) : (
    <button
      class:list={[
        ...baseClass,
        ...(variantClass[variant] || []),
        ...sizeClass,
        ...gapClass,
        ...additionalClasses,
      ]}
      {...rest}
    >
      {iconOnly ? (
        <slot name="icon" />
      ) : (
        <>
          <slot name="left-icon" />
          <slot />
          <slot name="right-icon" />
        </>
      )}
    </button>
  )
}
