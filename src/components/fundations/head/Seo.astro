---
import { AstroSeo } from "@lexingtonthemes/seo";
import { site } from "@/site.config";
import { getOgImageUrl } from "@/lib/cloudinary";
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: string;
  canonical?: string;
}
const {
  title = site.name,
  description = site.description,
  ogImage,
  type = "website",
  canonical,
} = Astro.props;
const base = Astro.site ?? new URL("http://localhost:4321");
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, base).href;
const image = ogImage ?? getOgImageUrl(site.ogImage, { cloudName: site.ogCloudName });
---

<AstroSeo
  title={title}
  description={description}
  canonical={canonicalUrl}
  openGraph={{
    url: canonicalUrl,
    title,
    description,
    images: [
      {
        url: image,
        width: 1200,
        height: 630,
        alt: site.name,
        type: "image/jpeg",
      },
    ],
    site_name: site.name,
    type,
    locale: "en_US",
  }}
  twitter={{ cardType: "summary_large_image" }}
/>
