---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import PageHeader from "@/components/global/PageHeader.astro";
import BlogCard from "@/components/blog/BlogCard.astro";
// Content
import { getPosts } from "@/lib/blog";
const posts = await getPosts();
---

<BaseLayout title="Writing" description="Every post on Living Life, newest first.">
  <PageHeader title="Writing" intro="Every post, newest first." />
  <section>
    <Wrapper variant="standard" class="py-12">
      {
        posts.length > 0 ? (
          <ul class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <li>
                <BlogCard post={post} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-muted-foreground">No posts yet.</p>
        )
      }
    </Wrapper>
  </section>
</BaseLayout>
