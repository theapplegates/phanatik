---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
// Components
import PageHeader from "@/components/global/PageHeader.astro";
import SportFront from "@/components/sports/SportFront.astro";
// Content
import { sports, sportSlug, sportIntros } from "@/lib/sports";
export function getStaticPaths() {
  return sports.map((sport) => ({ params: { sport: sportSlug(sport) }, props: { sport } }));
}
const { sport } = Astro.props;
---

<BaseLayout>
  <PageHeader title={sport} intro={sportIntros[sport]} />
  <SportFront sport={sport} />
</BaseLayout>
