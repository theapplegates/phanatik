---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
// Components
import PageHeader from "@/components/global/PageHeader.astro";
import LegalArticle from "@/components/legal/LegalArticle.astro";
// Content
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const legal = await getCollection("legal");
  return legal.map((page) => ({ params: { slug: page.id }, props: { page } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout>
  <PageHeader title={page.data.page} />
  <LegalArticle page={page}>
    <Content />
  </LegalArticle>
</BaseLayout>
