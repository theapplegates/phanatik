---
// Fundations
import WriterLayout from "@/layouts/WriterLayout.astro";
// Content
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const writers = await getCollection("writers");
  return writers.map((writer) => ({ params: { id: writer.id }, props: { writer } }));
}
const { writer } = Astro.props;
const { Content } = await render(writer);
---

<WriterLayout id={writer.id} frontmatter={writer.data}>
  <Content />
</WriterLayout>
