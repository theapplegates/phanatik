---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
// Components
import WriterProfile from "@/components/writers/WriterProfile.astro";
// Content
import type { CollectionEntry } from "astro:content";
interface Props {
  id: string;
  frontmatter: CollectionEntry<"writers">["data"];
}
const { id, frontmatter } = Astro.props;
---

<BaseLayout>
  <WriterProfile id={id} frontmatter={frontmatter} />
  <slot />
</BaseLayout>
