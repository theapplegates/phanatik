---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
// Components
import BlogArticle from "@/components/blog/BlogArticle.astro";
// Content
import { getOgImageUrl } from "@/lib/cloudinary";
import { postMarkdown, type Post } from "@/lib/blog";
interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, coverImage, coverCloudName } = post.data;
const ogImage = coverImage ? getOgImageUrl(coverImage, { cloudName: coverCloudName }) : undefined;
---

<BaseLayout title={title} description={description} ogImage={ogImage} type="article" markdown={postMarkdown(post)}>
  <BlogArticle post={post}>
    <slot />
  </BlogArticle>
</BaseLayout>
